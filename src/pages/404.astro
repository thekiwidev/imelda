---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Imelda Yayala" description="This page does not exist. Start from the home page to plan your study, work or travel abroad.">
  <section class="sec" style="background: var(--paper)">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
      <span class="tab">404</span>
      <h1 class="display" style="max-width: 14ch">This page took a different flight.</h1>
      <p class="lead">The link may be old or mistyped. Start again from the home page.</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </section>
</Base>
