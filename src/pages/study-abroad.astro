---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Photo from '../components/Photo.astro';
import Avatar from '../components/Avatar.astro';
import WaLink from '../components/WaLink.astro';
import studentLaptop from '../assets/photos/student-laptop.jpeg';
import consultation from '../assets/photos/consultation.jpeg';
import type { Faq } from '../data/site';

const LEVELS = [
  { id: 'fnd', num: '01', label: 'Foundation', sub: 'A preparation year before a degree', docs: ['Valid international passport', 'Secondary school results (e.g. WAEC, NECO)', 'Proof of funds or sponsor letter', 'English test result, if required', 'Short personal statement', 'Birth certificate'] },
  { id: 'ug', num: '02', label: 'Undergraduate', sub: "A bachelor's degree after secondary school", docs: ['Valid international passport', 'Secondary school results (e.g. WAEC, NECO)', 'Personal statement', 'One academic reference', 'Proof of funds or sponsor letter', 'English test result, if required'] },
  { id: 'pg', num: '03', label: "Master's", sub: 'Taught or research, after your first degree', docs: ['Valid international passport', 'Degree certificate and transcripts', 'Personal statement', 'Two references', 'CV', 'Proof of funds; English test if required'] },
  { id: 'phd', num: '04', label: 'PhD', sub: 'Doctoral research with a supervisor', docs: ['Valid international passport', 'Research proposal', "Master's and bachelor's transcripts", 'Academic CV and any publications', 'Two or three references', 'Supervisor contact, where needed'] },
];
const DEFAULT_LEVEL = 'pg';
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const DESTS = [
  { code: 'LHR', codes: 'SEP · JAN', country: 'United Kingdom', m: [0, 8], intakes: 'September, January', funds: 'Funds held for a set period before you apply', after: 'Graduate route', lang: 'English' },
  { code: 'YYZ', codes: 'SEP · JAN · MAY', country: 'Canada', m: [0, 4, 8], intakes: 'September, January, May', funds: 'Proof of funds for tuition and living costs', after: 'Post-graduation work permit, for eligible programmes', lang: 'English or French' },
  { code: 'JFK', codes: 'AUG · JAN', country: 'United States', m: [0, 7], intakes: 'August, January', funds: 'Funding shown on your I-20', after: 'OPT work authorisation', lang: 'English' },
  { code: 'FRA', codes: 'OCT · APR', country: 'Germany', m: [3, 9], intakes: 'October, April', funds: 'Usually a blocked account', after: 'Job-seeker residence permit', lang: 'German or English' },
  { code: 'DUB', codes: 'SEP · JAN', country: 'Ireland', m: [0, 8], intakes: 'September, January', funds: 'Proof of funds for living costs', after: 'Stay-back permission for graduates', lang: 'English' },
  { code: 'MEL', codes: 'FEB · JUL', country: 'Australia', m: [1, 6], intakes: 'February, July', funds: 'Evidence of financial capacity', after: 'Temporary Graduate visa', lang: 'English' },
];
const FAQS: Faq[] = [
  { q: 'Can you guarantee admission or a visa?', a: 'No. Universities decide admission and embassies decide visas. We make sure your application is complete, honest and on time, and we tell you plainly when a profile needs more work.' },
  { q: 'How much money do I need to show?', a: 'It depends on the country, the city and your course fee. We work out the figure from the current official rules, and how long it must be held, before you apply.' },
  { q: "I'm applying from outside Nigeria. Can you help?", a: "Yes. Many clients apply from other countries. We work over WhatsApp and video, and check the rules for wherever you're applying from." },
  { q: 'Do you help with scholarships?', a: 'We search for funding you actually qualify for and add the deadlines to your plan. Scholarships are competitive, so we treat them as a bonus, not the budget.' },
];
const statement = [
  { n: 1, title: 'We ask, you write', body: 'A guided interview pulls out the stories only you can tell.' },
  { n: 2, title: 'We edit for clarity', body: 'Line-by-line notes on structure, evidence and length.' },
  { n: 3, title: 'You sign off', body: 'The final version is yours, in your voice, and you can defend every line at interview.' },
];
const sponsors = [
  { t: 'Sponsor letter', d: 'Who is paying, how much, and your relationship to the student.' },
  { t: 'Bank statements', d: 'For the period and amount the destination asks for. We check both before you print anything.' },
  { t: 'Proof of income', d: 'Employment letter or business documents that explain where the money comes from.' },
];
const strike = 'text-decoration: line-through; text-decoration-color: var(--danger); color: var(--ink-subtle)';
const fix = 'background: var(--forest-tint); color: var(--forest); border-bottom: 2px solid var(--signal); padding: 0 2px';
const numDot = 'width: 40px; height: 40px; border-radius: 999px; border: 2px solid var(--forest); display: flex; align-items: center; justify-content: center; font-family: var(--f-mono); font-weight: 500; font-size: 14px; color: var(--forest)';
---

<Base
  title="Study Abroad with a Plan You Can Defend | Imelda Yayala"
  description="Study abroad with a plan you can defend. Foundation to PhD: we help students and parents choose the right course, prepare one strong application and file the student visa."
  breadcrumbs={[{ name: 'Study abroad', path: '/study-abroad/' }]}
  faqs={FAQS}
  service={{ name: 'Study abroad and student visa support', serviceType: 'Student visa consultancy', description: 'Course selection, personal statement coaching, proof of funds review and student visa applications for the UK, Canada, the US, Germany, Ireland and Australia.' }}
>
  <!-- HERO -->
  <section id="top" style="position: relative; overflow: hidden; padding: 64px 0 96px; background: var(--paper)">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 40px">
      <Breadcrumb current="Study abroad" />
      <div class="g-hero" style="align-items: start">
        <div class="hero-copy" style="display: flex; flex-direction: column; gap: 28px; align-items: flex-start; padding-top: 16px">
          <h1 class="display" style="max-width: 13ch">Study abroad with a plan you can defend.</h1>
          <p class="lead">Foundation to PhD. We help students and parents choose the right course, prepare one strong application instead of five rushed ones, and file the student visa.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 12px">
            <WaLink class="btn btn-primary" message="Hello Imelda Yayala, I'd like to plan my studies abroad.">Plan my studies <Icon name="arrow" size={20} stroke="var(--signal)" strokeWidth={2} class="arr" /></WaLink>
            <a class="btn btn-secondary" href="#compare">Compare destinations</a>
          </div>
          <p class="muted" style="margin: 0; font-size: 14px; line-height: 22px; display: flex; align-items: center; gap: 8px"><Icon name="shieldCheck" size={16} stroke="var(--forest)" /> Free 30-minute assessment. Parents and sponsors are welcome on the call.</p>
        </div>

        <div class="hero-visual" style="position: relative; padding-bottom: 40px">
          <div>
            <Photo eager src={studentLaptop} alt="Smiling student working on a laptop" style="height: 600px" />
          </div>
          <div class="card hero-float" style="position: absolute; left: -28px; bottom: 0; padding: 18px 20px; display: flex; gap: 14px; align-items: center; box-shadow: var(--shadow-md); max-width: 320px">
            <Avatar initials="TA" size={48} />
            <span style="display: flex; flex-direction: column; gap: 2px"><span style="font-weight: 600; font-size: 14px">Tobi A.</span><span class="meta" style="font-size: 11px; color: var(--ink-subtle)">MSC · UNITED KINGDOM · CLASS OF 2025</span></span>
          </div>
          <div style="position: absolute; right: 20px; top: 20px"><span class="chip chip-forest"><Icon name="check" size={12} stroke="var(--signal)" strokeWidth={2.5} />ADMITTED</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- LEVEL SELECTOR -->
  <section id="level" class="sec" style="background: var(--surface); border-top: 1px solid var(--line)">
    <div class="wrap g-split" style="align-items: start">
      <div style="display: flex; flex-direction: column; gap: 20px; align-items: flex-start; position: sticky; top: 104px">
        <h2 class="h1">Your level decides the documents.</h2>
        <p class="lead">Each level of study needs a different set of documents. Here is what you'll usually prepare; we confirm the exact list for your course in the free consultation.</p>
        <Photo src={consultation} alt="Consultant meeting with a student and parent" style="height: 260px; width: 100%; margin-top: 8px" />
      </div>
      <div class="card level-card" data-levels-root style="padding: 28px; display: flex; flex-direction: column; gap: 20px; box-shadow: var(--shadow-md)">
        <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px">
          <h3 class="h3" id="level-label">What will you study?</h3>
        </div>
        <div role="radiogroup" aria-labelledby="level-label" data-levels style="display: flex; flex-direction: column; gap: 8px">
          {LEVELS.map((l) => (
            <button type="button" class="lvl" role="radio" aria-checked={l.id === DEFAULT_LEVEL ? 'true' : 'false'} data-id={l.id} data-label={l.label}>
              <span class="num">{l.num}</span>
              <span style="display: flex; flex-direction: column; gap: 2px"><span style="font-weight: 600">{l.label}</span><span class="muted" style="font-size: 13px; line-height: 20px">{l.sub}</span></span>
              <span class="radio"></span>
            </button>
          ))}
        </div>
        <div style="padding: 20px; border-radius: 8px; background: var(--forest-tint); display: flex; flex-direction: column; gap: 12px">
          {LEVELS.map((l) => (
            <div data-level-docs data-key={l.id} hidden={l.id !== DEFAULT_LEVEL} style="display: flex; flex-direction: column; gap: 12px">
              <h4 style="margin: 0; font-weight: 600; font-size: 14px; line-height: 20px; color: var(--forest)">Usually needed for {l.label}</h4>
              <ul class="bullets" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 16px">
                {l.docs.map((d) => <li style="font-size: 14px; line-height: 22px"><Icon name="bullet" size={10} stroke="var(--forest)" />{d}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- INTAKE CALENDAR -->
  <section id="calendar" class="sec" style="background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line)">
    <div class="wrap" data-cal-root style="display: flex; flex-direction: column; gap: 40px">
      <div class="g-hw">
        <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start">
          <h2 class="h1">Start dates decide everything else.</h2>
          <p class="lead">Each destination has its own main intakes. We plan your applications, funds and visa backwards from the one you choose.</p>
        </div>
        <div role="group" aria-label="Destination" data-cal-dests style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end">
          {DESTS.map((d, i) => (
            <button type="button" class="dest" aria-pressed={i === 0 ? 'true' : 'false'} data-months={d.m.join(',')} data-country={d.country} data-intakes={d.codes}><span class="meta">{d.code}</span>{d.country}</button>
          ))}
        </div>
      </div>
      <ol class="g-cal" aria-label="Main intake months" data-months-grid>
        {MONTHS.map((name, i) => (
          <li class:list={['month', { on: DESTS[0].m.includes(i) }]}>
            <span class="overline">{name}</span>
            <span class="tag"><span></span>Intake</span>
          </li>
        ))}
      </ol>
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; align-items: center">
        <span class="meta" style="color: var(--ink-subtle)" aria-live="polite"><span data-cal="country">{DESTS[0].country}</span> · MAIN INTAKES · <span data-cal="intakes">{DESTS[0].codes}</span></span>
        <span class="muted" style="font-size: 14px; line-height: 22px">Intakes vary by university and course. Applications often open many months ahead.</span>
      </div>
    </div>
  </section>

  <!-- PERSONAL STATEMENT -->
  <section class="sec" style="background: var(--paper)">
    <div class="art" aria-hidden="true">
      <div style="position: absolute; inset: -30px">
        <svg width="100%" height="100%" preserveAspectRatio="none" viewBox="0 0 1440 900">
          <g stroke="var(--signal)" stroke-width="1">{Array.from({ length: 18 }, (_, i) => <path d={`M0 ${120 + i * 40} H1440`}></path>)}</g>
          <path d="M96 0 V900" stroke="#b42318" stroke-width="1.5"></path>
        </svg>
      </div>
    </div>
    <div class="wrap g-split">
      <div style="display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
        <h2 class="h1">Your words, sharpened. Never written for you.</h2>
        <p class="muted" style="margin: 0; max-width: 52ch">Admissions teams read thousands of statements. The ones that work sound like a real person with a clear reason. We coach you to that, draft by draft.</p>
        <ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 20px">
          {statement.map((s) => (
            <li style="display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 16px">
              <span style={numDot} aria-hidden="true">{s.n}</span>
              <span style="display: flex; flex-direction: column; gap: 2px"><h3 class="h3" style="font-size: 18px">{s.title}</h3><span class="muted" style="font-size: 15px; line-height: 24px">{s.body}</span></span>
            </li>
          ))}
        </ol>
      </div>
      <figure aria-label="Example of an edited personal statement" style="margin: 0; position: relative">
        <div class="card pad-sm" style="padding: 40px 40px 40px 56px; box-shadow: var(--shadow-md); position: relative; overflow: hidden">
          <div aria-hidden="true" style="position: absolute; left: 32px; top: 0; bottom: 0; width: 1px; background: rgba(180,35,24,.35)"></div>
          <span class="meta" style="color: var(--ink-subtle)">DRAFT 2 · PERSONAL STATEMENT · MSC DATA SCIENCE</span>
          <p style="margin: 20px 0 0; font-size: 16px; line-height: 30px">
            <del style={strike}>I have always been passionate about computers since I was a child.</del>
            <ins style={`${fix}; text-decoration: none`}>In my final year, I built a tool that cut my department's exam-timetable clashes by a third.</ins>
            That project showed me how much good data work can change for the people relying on it.
            <del style={strike}>This course is the best in the world.</del>
            <ins style={`${fix}; text-decoration: none`}>Your module on applied machine learning is the next step I need.</ins>
          </p>
        </div>
        <aside class="hide-sm" style="position: absolute; right: -16px; top: 28px; width: 220px; padding: 14px 16px; background: var(--lime-tint); border: 1px solid var(--lime-line); border-radius: 8px; box-shadow: var(--shadow-sm); transform: rotate(1.5deg)">
          <span class="meta" style="color: var(--forest)">CONSULTANT NOTE</span>
          <p style="margin: 6px 0 0; font-size: 13px; line-height: 20px">Show what you did, not how you felt. One real result beats three adjectives.</p>
        </aside>
        <span class="chip chip-forest" style="position: absolute; left: 24px; bottom: -22px; padding: 8px 12px; gap: 6px"><Icon name="check" size={12} stroke="var(--signal)" strokeWidth={2.5} />YOUR WORDS · OUR NOTES</span>
      </figure>
    </div>
  </section>

  <!-- COMPARE TABLE -->
  <section id="compare" class="sec" style="background: var(--surface); border-top: 1px solid var(--line)">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 40px">
      <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start; max-width: 720px">
        <h2 class="h1">Six countries, side by side.</h2>
        <p class="lead">The short version. Rules change, so we check current official guidance for your case before you apply.</p>
      </div>
      <div style="overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--surface)">
        <table class="tbl">
          <caption class="sr-only">Study abroad destinations compared: funds evidence, post-study work and teaching language</caption>
          <thead><tr><th scope="col">Destination</th><th scope="col">Funds evidence</th><th scope="col">After you graduate</th><th scope="col">Teaching language</th></tr></thead>
          <tbody>
            {DESTS.map((d) => (
              <tr>
                <th scope="row"><span style="display: flex; flex-direction: column; gap: 2px"><span class="meta" style="color: var(--forest)">{d.code}</span><span style="font-weight: 600">{d.country}</span></span></th>
                <td>{d.funds}</td><td>{d.after}</td><td>{d.lang}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- PARENTS -->
  <section class="sec" style="background: var(--paper); padding-top: 0">
    <div class="wrap">
      <div class="g-2col pad-sm" style="background: var(--lime-tint); border: 1px solid var(--lime-line); border-radius: 12px; padding: 48px; gap: 48px">
        <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start">
          <h2 class="h1" style="font-size: 30px; line-height: 38px">You are paying for it. You should see the plan.</h2>
          <p class="muted" style="margin: 0">Sponsors usually provide the funds evidence, so we involve you from the first call. You get the same written plan and updates the student gets.</p>
          <WaLink class="btn btn-secondary" message="Hello Imelda Yayala, I'm a parent/sponsor and I'd like to join a study abroad consultation.">Join the consultation</WaLink>
        </div>
        <ul class="bullets" style="display: flex; flex-direction: column; gap: 16px">
          {sponsors.map((s) => (
            <li style="gap: 12px"><Icon name="bullet" size={10} stroke="var(--forest)" /><span><b style="font-weight: 600">{s.t}</b><br /><span class="muted" style="font-size: 15px">{s.d}</span></span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="sec" style="background: var(--surface-sunken)">
    <div class="wrap g-faq">
      <h2 class="h1">What students and parents ask us most.</h2>
      <FaqAccordion faqs={FAQS} group="faq-study" />
    </div>
  </section>

  <!-- CLOSING -->
  <section id="contact" class="sec" style="background: var(--paper)">
    <div class="wrap">
      <div class="card g-2col" style="padding: 0; overflow: hidden; box-shadow: var(--shadow-md)">
        <div class="split-left pad-sm" style="padding: 48px; display: flex; flex-direction: column; gap: 20px; justify-content: center; border-right: 1px solid var(--line)">
          <h2 class="h1">Tell us what you want to study.</h2>
          <p class="muted" style="margin: 0">Choose your level and destination, and WhatsApp opens with your message ready to send. A consultant replies to book your free 30-minute assessment. Bring your results; we'll bring the plan.</p>
        </div>
        <div class="pad-sm" style="padding: 48px; background: var(--surface-sunken)">
          <form id="study-form" action="#contact" style="display: flex; flex-direction: column; gap: 20px">
            <div><label class="flabel" for="s-level">Level of study</label><div class="field"><Icon name="cap" size={20} class="lead-ic" /><select id="s-level" name="level" class="input"><option>Foundation</option><option>Undergraduate</option><option>Master's</option><option>PhD</option><option>Not sure yet</option></select><Icon name="chevron" size={20} class="trail-ic" /></div></div>
            <div><label class="flabel" for="s-dest">Destination</label><div class="field"><Icon name="pin" size={18} class="lead-ic" /><select id="s-dest" name="destination" class="input"><option>United Kingdom</option><option>Canada</option><option>United States</option><option>Germany</option><option>Ireland</option><option>Australia</option><option>Help me choose</option></select><Icon name="chevron" size={20} class="trail-ic" /></div></div>
            <button type="submit" class="btn btn-primary btn-block"><Icon name="whatsapp" size={20} /> Continue on WhatsApp</button>
            <span style="font-size: 13px; line-height: 20px; color: var(--ink-subtle)">Opens WhatsApp with your answers in a message. Nothing is sent until you press send.</span>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { selectIn, showOnly, autoplay, openWhatsApp } from '../scripts/ui';

  const $$ = <T extends HTMLElement>(sel: string) => Array.from(document.querySelectorAll<T>(sel));

  const levels = $$('[data-levels] button');
  const pickLevel = (b: HTMLElement) => {
    selectIn(levels, b, 'aria-checked');
    showOnly($$('[data-level-docs]'), b.dataset.id!);
  };
  levels.forEach((b) => {
    b.addEventListener('click', () => pickLevel(b));
    b.addEventListener('mouseenter', () => pickLevel(b));
  });
  autoplay(document.querySelector('[data-levels-root]'), {
    count: levels.length,
    current: () => levels.findIndex((b) => b.getAttribute('aria-checked') === 'true'),
    show: (i) => pickLevel(levels[i]),
    interval: 4000,
  });

  const dests = $$('[data-cal-dests] button');
  const months = $$('[data-months-grid] li');
  const pickDest = (b: HTMLElement) => {
    selectIn(dests, b);
    const on = new Set(b.dataset.months!.split(',').map(Number));
    months.forEach((m, i) => m.classList.toggle('on', on.has(i)));
    $$('[data-cal="country"]').forEach((el) => (el.textContent = b.dataset.country!));
    $$('[data-cal="intakes"]').forEach((el) => (el.textContent = b.dataset.intakes!));
  };
  dests.forEach((b) => {
    b.addEventListener('click', () => pickDest(b));
    b.addEventListener('mouseenter', () => pickDest(b));
  });
  autoplay(document.querySelector('[data-cal-root]'), {
    count: dests.length,
    current: () => dests.findIndex((b) => b.getAttribute('aria-pressed') === 'true'),
    show: (i) => pickDest(dests[i]),
    interval: 3500,
  });

  // Closing form: crafts a WhatsApp message from the visitor's choices.
  document.querySelector<HTMLFormElement>('#study-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(e.currentTarget as HTMLFormElement);
    openWhatsApp(
      `Hello Imelda Yayala, I'd like to study abroad.\nLevel of study: ${data.get('level')}\nDestination: ${data.get('destination')}\nPlease help me book a free consultation.`,
    );
  });
</script>
