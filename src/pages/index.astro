<script>
  import { selectIn, showOnly, autoplay } from '../scripts/ui';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const $$ = <T extends HTMLElement>(sel: string) => Array.from(document.querySelectorAll<T>(sel));
  const out = (key: string, text: string) => $$(`[data-out="${key}"]`).forEach((el) => (el.textContent = text));

  // Hero ticket: destination picker, auto-advancing
  const dests = $$('[data-dests] button');
  const pickDest = (b: HTMLElement) => {
    selectIn(dests, b);
    out('code', b.dataset.code!);
    out('city', b.dataset.city!);
  };
  dests.forEach((b) => b.addEventListener('click', () => pickDest(b)));
  autoplay($('[data-dests]')?.parentElement ?? null, {
    count: dests.length,
    current: () => dests.findIndex((b) => b.getAttribute('aria-pressed') === 'true'),
    show: (i) => pickDest(dests[i]),
    interval: 3500,
  });

  // Steps (tabs): auto-advance; hovering a step shows it and pauses there.
  const tabs = $$('[data-steps] [role="tab"]');
  const pickStep = (tab: HTMLElement) => {
    const idx = tabs.indexOf(tab);
    tabs.forEach((t, i) => {
      t.setAttribute('aria-selected', String(t === tab));
      t.tabIndex = t === tab ? 0 : -1;
      t.classList.toggle('done', i < idx);
    });
    showOnly($$('[data-step-panel]'), tab.dataset.key!);
    $$('[data-step-panel]').forEach((p) => p.classList.add('in'));
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => pickStep(t));
    t.addEventListener('mouseenter', () => pickStep(t));
    t.addEventListener('keydown', (e) => {
      const next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
      if (next === null) return;
      const target = tabs[(next + tabs.length) % tabs.length];
      pickStep(target);
      target.focus();
    });
  });
  autoplay($('[data-steps-root]'), {
    count: tabs.length,
    current: () => tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true'),
    show: (i) => pickStep(tabs[i]),
    interval: 5000,
  });

  // Client stories
  const storyBtns = $$('[data-story-list] button');
  let story = 0;
  const showStory = (i: number) => {
    story = (i + storyBtns.length) % storyBtns.length;
    selectIn(storyBtns, storyBtns[story]);
    showOnly($$('[data-story]'), String(story));
    const pos = $('[data-story-pos]');
    if (pos) pos.textContent = String(story + 1);
  };
  storyBtns.forEach((b, i) => {
    b.addEventListener('click', () => showStory(i));
    b.addEventListener('mouseenter', () => showStory(i));
  });
  $('[data-story-prev]')?.addEventListener('click', () => showStory(story - 1));
  $('[data-story-next]')?.addEventListener('click', () => showStory(story + 1));

  autoplay($('[data-stories-root]'), { count: storyBtns.length, current: () => story, show: showStory, interval: 7000 });
</script>
