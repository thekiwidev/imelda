---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Photo from '../components/Photo.astro';
import Avatar from '../components/Avatar.astro';
import WaLink from '../components/WaLink.astro';
import travellerDeparture from '../assets/photos/traveller-departure.jpeg';
import studentCampus from '../assets/photos/student-campus.jpeg';
import healthcareWorker from '../assets/photos/healthcare-worker.webp';
import familyReunion from '../assets/photos/family-reunion.webp';
import consultation from '../assets/photos/consultation.jpeg';
import { site, type Faq } from '../data/site';

const DESTS = [
  { country: 'United Kingdom', code: 'LHR', city: 'London' },
  { country: 'Canada', code: 'YYZ', city: 'Toronto' },
  { country: 'United States', code: 'JFK', city: 'New York' },
  { country: 'Germany', code: 'FRA', city: 'Frankfurt' },
  { country: 'Ireland', code: 'DUB', city: 'Dublin' },
  { country: 'Australia', code: 'MEL', city: 'Melbourne' },
];
const STEPS = [
  { title: 'Free consultation', code: 'ASSESS', duration: '30 minutes', body: 'A 30-minute call or office visit. We look at your goal, budget, documents and any past refusals, then tell you honestly whether to go ahead now or wait.', bring: 'Your passport, any offer or job letter, and past refusal letters if you have them.' },
  { title: 'Plan and shortlist', code: 'PLAN', duration: '2–3 working days', body: 'We match you to programmes, employers or visa routes that fit your profile, and give you a written plan with every fee listed before you commit.', bring: 'Transcripts or CV, your preferred start date, and your budget.' },
  { title: 'Documents and statements', code: 'PREPARE', duration: '1–2 weeks', body: 'We review every document against the official checklist, help you write your personal statement or CV in your own words, and check proof of funds.', bring: 'Bank statements, sponsor letters and certificates.' },
  { title: 'Application and biometrics', code: 'SUBMIT', duration: '1 week, plus your appointment', body: 'We complete and submit the application with you, book your biometrics appointment and prepare you for any interview.', bring: 'Your time for biometrics and, if needed, an interview.' },
  { title: 'Decision and flights', code: 'DEPART', duration: 'Set by the embassy', body: 'When the decision arrives we walk you through it. Approved: we book flights and run pre-departure checks. Refused: we explain why and plan the next step together.', bring: 'Your preferred travel dates.' },
];
const STORIES = [
  { name: 'Adaeze O.', initials: 'AO', context: 'STUDENT VISA · UNITED KINGDOM · 2025', quote: 'I had been refused once and was ready to give up. They went through my bank statements line by line and showed me exactly what the officer needed to see. My visa came back in three weeks.' },
  { name: 'Chinedu E.', initials: 'CE', context: 'SKILLED WORKER · CANADA · 2024', quote: 'Someone had asked me to pay for a job offer. Imelda Yayala checked the employer before I spent a kobo and found me the real route. Eight months later I started work in Calgary.' },
  { name: 'Halima B.', initials: 'HB', context: 'FAMILY VISIT · UNITED STATES · 2025', quote: 'My daughter was graduating in Houston and the date could not move. They planned everything backwards from that day and prepared me for the interview. I was in the hall when she walked.' },
];
const FAQS: Faq[] = [
  { q: 'Can you guarantee my visa?', a: 'No one can, and you should be wary of anyone who says they can. Only the embassy or immigration authority decides. What we promise is a complete, honest application and a clear explanation at every step.' },
  { q: 'How much do your services cost?', a: 'It depends on the service and destination. Visitor visa support starts from ₦150,000 and full study abroad packages from ₦450,000. You get a written quote after the free consultation, before you pay anything. Government visa fees are paid directly to the official application centre, not to us.' },
  { q: 'I was refused before. Can you still help?', a: 'Yes. Bring the refusal letter to your consultation. We read the stated reasons, fix what can be fixed, and tell you plainly if waiting would serve you better.' },
  { q: 'How do I know you are a real company?', a: `Visit our office at ${site.address.street}, ${site.address.city}, and speak to a named consultant. We have worked with clients since ${site.foundedYear}, and every client gets a reference number and written receipts.` },
  { q: 'Can we do everything over WhatsApp?', a: 'Most of it. Consultations, document checks and updates can happen on WhatsApp or video call. You only need to appear in person for biometrics or an embassy interview.' },
];
const COVERAGE = [
  'United Kingdom', 'Canada', 'United States', 'Ireland', 'Germany', 'France', 'Netherlands', 'Belgium', 'Italy', 'Spain',
  'Portugal', 'Poland', 'Sweden', 'Finland', 'Malta', 'Cyprus', 'Switzerland', 'Australia', 'New Zealand', 'United Arab Emirates',
  'South Africa', 'Ghana', 'Kenya', 'Rwanda', 'Egypt', 'Morocco', 'Mauritius', 'Malaysia',
];
const STATS = [
  { n: '2,500+', label: `Clients guided since ${site.foundedYear}` },
  { n: '30+', label: 'Countries we file applications for' },
  { n: '650+', label: 'Approved applications in 2025' },
  { n: `${new Date().getFullYear() - site.foundedYear}`, label: `Years helping clients from ${site.address.city}` },
];
const muted = 'font-size: 15px; line-height: 24px; color: var(--ink-muted)';
const pass = 'font-family: var(--f-display); font-weight: 600; font-size: 34px; line-height: 38px; letter-spacing: -.02em';
---

<Base
  title="Study, Work and Travel Abroad from Nigeria | Imelda Yayala"
  description="Your move abroad, handled properly. We guide students, workers and travellers from Nigeria through the programme or role, the documents, the visa and the flight."
  faqs={FAQS}
>
  <!-- HERO -->
  <section id="top" style="position: relative; overflow: hidden; padding: 112px 0 96px; background: var(--paper)">
    <div class="art" aria-hidden="true">
      <svg width="100%" height="100%" viewBox="0 0 1440 820" preserveAspectRatio="xMidYMid slice" fill="none" stroke="var(--signal)">
        <g transform="translate(-80 570) rotate(-14)" stroke-width="3">
          <rect width="230" height="310" rx="18"></rect>
          <rect x="14" y="14" width="202" height="282" rx="10" stroke-width="1.5"></rect>
          <circle cx="115" cy="120" r="48"></circle><circle cx="115" cy="120" r="30" stroke-width="1.5"></circle>
          <path d="M67 120 H163 M115 72 V168" stroke-width="1.5"></path>
          <text x="115" y="230" fill="var(--signal)" stroke="none" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="22" letter-spacing="6">PASSPORT</text>
        </g>
        <g transform="translate(1280 590) rotate(-9)">
          <rect width="250" height="120" rx="10" stroke-width="4"></rect>
          <rect x="8" y="8" width="234" height="104" rx="6" stroke-width="1.5"></rect>
          <g fill="var(--signal)" stroke="none" text-anchor="middle" font-family="IBM Plex Mono, monospace">
            <text x="125" y="38" font-size="14" letter-spacing="4">ENTRY VISA</text>
            <text x="125" y="78" font-family="Sora, sans-serif" font-size="34" font-weight="600" letter-spacing="2">APPROVED</text>
            <text x="125" y="100" font-size="12" letter-spacing="3">ABV · 2026</text>
          </g>
        </g>
      </svg>
    </div>
    <div class="wrap g-hero">
      <div class="hero-copy" style="display: flex; flex-direction: column; gap: 28px; align-items: flex-start">
        <h1 class="display" style="max-width: 14ch">Your move abroad, handled properly.</h1>
        <p class="lead" style="max-width: 46ch">Study, work or travel: we guide you through the right programme or role, the documents, the visa and the flight. One team, one plan.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px">
          <WaLink class="btn btn-primary">Book a free consultation <Icon name="arrow" size={20} stroke="var(--signal)" strokeWidth={2} class="arr" /></WaLink>
          <a class="btn btn-secondary" href="#how">See how it works</a>
        </div>
        <p class="muted" style="margin: 0; font-size: 14px; line-height: 22px; display: flex; align-items: center; gap: 8px"><Icon name="shieldCheck" size={16} stroke="var(--forest)" /> Free 30-minute assessment. No payment to start.</p>
      </div>

      <!-- Hero visual: photo, client chip and boarding ticket -->
      <div class="hero-visual" style="position: relative; padding: 0 0 64px 48px">
        <div>
          <Photo eager src={travellerDeparture} alt="Smiling traveller holding a passport and boarding pass" style="height: 620px" />
        </div>
        <div style="position: absolute; left: 0; bottom: 0; width: 380px; max-width: calc(100% - 24px); background: var(--forest); color: var(--on-forest); border-radius: 12px; padding: 22px 24px; box-shadow: 0 4px 8px rgba(15,61,31,.05), 0 24px 48px rgba(15,61,31,.12)">
          <div style="display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 14px; align-items: center">
            <div style="display: flex; flex-direction: column; gap: 2px"><span class="overline" style="color: var(--on-forest-muted)">From</span><span style={pass}>ABV</span><span style="font-size: 12px; line-height: 16px; color: var(--on-forest-muted)">Abuja</span></div>
            <div aria-hidden="true" style="display: flex; align-items: center; gap: 6px; min-width: 0"><div style="flex: 1; border-top: 2px dashed rgba(183,203,189,.5)"></div><Icon name="plane" size={22} stroke="var(--signal)" /><div style="flex: 1; border-top: 2px dashed rgba(183,203,189,.5)"></div></div>
            <div aria-live="polite" style="display: flex; flex-direction: column; gap: 2px; text-align: right"><span class="overline" style="color: var(--on-forest-muted)">To</span><span data-out="code" style={`${pass}; color: var(--signal)`}>{DESTS[0].code}</span><span data-out="city" style="font-size: 12px; line-height: 16px; color: var(--on-forest-muted)">{DESTS[0].city}</span></div>
          </div>
          <div role="group" aria-label="Choose a destination" data-dests style="margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(183,203,189,.25); display: flex; flex-wrap: wrap; gap: 4px">
            {DESTS.map((d, i) => (
              <button type="button" class="tick-dest" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={d.country} data-code={d.code} data-city={d.city}>{d.code}</button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RECORD AND COVERAGE -->
  <section aria-labelledby="record-h" class="on-dark record" style="background: var(--forest); color: var(--on-forest)">
    <h2 id="record-h" class="sr-only">Our record and coverage</h2>
    <div class="wrap">
      <dl class="stats">
        {STATS.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.n}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="wrap" style="display: flex; align-items: center; gap: 32px; height: 64px; border-top: 1px solid rgba(183,203,189,.2)">
      <span style="flex: none; font-weight: 600; font-size: 14px">Our coverage</span>
      <div class="marquee" style="flex: 1; min-width: 0; color: var(--on-forest-muted); font-size: 14px">
        <ul class="marquee-track" aria-label="Countries we file applications for">
          {COVERAGE.map((c) => <li>{c}</li>)}
        </ul>
        <ul class="marquee-track" aria-hidden="true">
          {COVERAGE.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section id="services" class="sec" style="background: var(--paper)">
    <div class="art" aria-hidden="true">
      <svg style="position: absolute; right: -80px; top: 40px" width="620" height="900" viewBox="0 0 620 900">
        <defs>
          <pattern id="adire" width="124" height="124" patternUnits="userSpaceOnUse">
            <circle cx="62" cy="62" r="40" fill="none" stroke="var(--signal)" stroke-width="3"></circle>
            <circle cx="62" cy="62" r="28" fill="none" stroke="var(--signal)" stroke-width="3"></circle>
            <circle cx="62" cy="62" r="16" fill="none" stroke="var(--signal)" stroke-width="3"></circle>
            <circle cx="62" cy="62" r="5" fill="var(--signal)"></circle>
            <circle cx="0" cy="0" r="6" fill="var(--signal)"></circle><circle cx="124" cy="0" r="6" fill="var(--signal)"></circle><circle cx="0" cy="124" r="6" fill="var(--signal)"></circle><circle cx="124" cy="124" r="6" fill="var(--signal)"></circle>
            <path d="M0 62 l10 -8 l10 8 l10 -8" fill="none" stroke="var(--signal)" stroke-width="2.5"></path>
            <path d="M94 62 l10 -8 l10 8 l10 -8" fill="none" stroke="var(--signal)" stroke-width="2.5"></path>
            <path d="M62 0 l-8 10 l8 10" fill="none" stroke="var(--signal)" stroke-width="2.5"></path>
            <path d="M62 104 l-8 10 l8 10" fill="none" stroke="var(--signal)" stroke-width="2.5"></path>
          </pattern>
        </defs>
        <rect width="620" height="900" fill="url(#adire)"></rect>
      </svg>
    </div>
    <div class="wrap" style="display: flex; flex-direction: column; gap: 48px">
      <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start; max-width: 720px">
        <h2 class="h1">One team for the whole journey, not just the form.</h2>
        <p class="lead">Every path starts with the same free assessment and ends with a clear next step.</p>
      </div>

      <!-- Desktop bento -->
      <div class="bento">
        <a href="/study-abroad/" class="card lift svc b-big">
          <Photo src={studentCampus} alt="Student with a backpack and notes on a university campus" style="height: 440px; object-position: 50% 22%; border-radius: 0; border: 0; border-bottom: 1px solid var(--line)" />
          <div style="padding: 32px; display: flex; flex-direction: column; gap: 12px; flex: 1">
            <h3 class="h1" style="font-size: 30px; line-height: 38px">Study abroad</h3>
            <p class="muted" style="margin: 0; max-width: 56ch">Undergraduate to PhD. We shortlist programmes, coach your personal statement and file the student visa, with parents in the loop.</p>
            <span style="display: flex; gap: 8px; align-items: center; font-weight: 600; color: var(--forest); margin-top: auto; padding-top: 8px">Explore <Icon name="arrow" size={22} class="go" stroke="var(--forest)" strokeWidth={2} /></span>
          </div>
        </a>
        <a href="/work-abroad/" class="card lift svc">
          <Photo src={healthcareWorker} alt="Healthcare worker in scrubs with a stethoscope" style="height: 160px; object-position: 50% 20%; border-radius: 0; border: 0; border-bottom: 1px solid var(--line)" />
          <div style="padding: 24px; display: flex; flex-direction: column; gap: 8px; flex: 1">
            <h3 class="h3">Work abroad</h3>
            <p style={`margin: 0; ${muted}`}>Offer checked, CV prepared, work visa filed.</p>
            <span style="display: flex; gap: 8px; align-items: center; font-weight: 600; color: var(--forest); margin-top: auto; padding-top: 8px">Explore <Icon name="arrow" size={22} class="go" stroke="var(--forest)" strokeWidth={2} /></span>
          </div>
        </a>
        <a href="/travel-visa/" class="card lift svc">
          <Photo src={familyReunion} alt="Family smiling together outdoors" style="height: 160px; border-radius: 0; border: 0; border-bottom: 1px solid var(--line)" />
          <div style="padding: 24px; display: flex; flex-direction: column; gap: 8px; flex: 1">
            <h3 class="h3">Travel and family visits</h3>
            <p style={`margin: 0; ${muted}`}>A dated plan so the trip happens on time.</p>
            <span style="display: flex; gap: 8px; align-items: center; font-weight: 600; color: var(--forest); margin-top: auto; padding-top: 8px">Explore <Icon name="arrow" size={22} class="go" stroke="var(--forest)" strokeWidth={2} /></span>
          </div>
        </a>
        <WaLink message="Hello Imelda Yayala, I'd like to ask about the priority concierge service." class="lift svc" style="background: var(--lime-tint); border: 1px solid var(--lime-line); border-radius: 12px; padding: 32px; gap: 14px; transition: box-shadow 200ms var(--ease), transform 200ms var(--ease)">
          <h3 class="h3">Priority concierge</h3>
          <p style={`margin: 0; ${muted}`}>A named consultant, faster document turnaround and appointments booked for you.</p>
          <div class="card-art" aria-hidden="true">
            <svg width="230" height="190" viewBox="0 0 230 190" fill="none" stroke="var(--forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M40 150 A70 70 0 0 1 180 150 Z" fill="var(--signal)" fill-opacity=".35"></path>
              <path d="M66 128 A46 46 0 0 1 90 98" stroke-width="2.5"></path>
              <rect x="22" y="150" width="176" height="14" rx="5" fill="var(--surface)"></rect>
              <rect x="103" y="66" width="14" height="14" rx="3"></rect>
              <path d="M96 66 H124"></path>
              <path d="M110 44 V30 M84 50 L76 40 M136 50 L144 40" stroke="var(--signal)" stroke-width="3.5"></path>
              <g transform="translate(160 28) rotate(14)">
                <path d="M0 10 L10 0 H62 V40 H10 L0 30 Z" fill="var(--surface)"></path>
                <circle cx="13" cy="20" r="4"></circle>
                <text x="38" y="25" fill="var(--forest)" stroke="none" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1">VIP</text>
              </g>
            </svg>
          </div>
          <span style="display: flex; gap: 8px; align-items: center; font-weight: 600; color: var(--forest); margin-top: auto">Ask about concierge <Icon name="arrow" size={22} class="go" stroke="var(--forest)" strokeWidth={2} /></span>
        </WaLink>
        <WaLink message="Hello Imelda Yayala, I was refused a visa before and would like a refusal review." class="lift svc b-wide on-dark refusal" style="background: var(--forest); color: var(--on-forest) !important; border-radius: 12px; clip-path: polygon(0 0, calc(100% - 36px) 0, 100% 36px, 100% 100%, 0 100%); transition: transform 200ms var(--ease); display: grid !important; grid-template-columns: minmax(0, 1fr) 260px">
          <div style="padding: 36px; display: flex; flex-direction: column; gap: 14px">
            <h3 class="h1" style="font-size: 28px; line-height: 36px; color: var(--on-forest)">Refused before? Start here.</h3>
            <p style="margin: 0; color: var(--on-forest-muted); max-width: 46ch">Bring your refusal letter. We read the stated reasons, fix what can be fixed, and tell you plainly when to reapply.</p>
            <div class="card-art" aria-hidden="true">
              <svg width="380" height="230" viewBox="0 0 380 230" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <g stroke="var(--on-forest-muted)" stroke-width="2">
                  <rect x="20" y="16" width="180" height="200" rx="8"></rect>
                  <path d="M44 48 H120 M44 74 H176 M44 96 H176 M44 118 H150 M44 186 H96" stroke-opacity=".7"></path>
                </g>
                <g transform="translate(66 132) rotate(-10)" stroke="#e8a59f" stroke-width="2.5">
                  <rect width="132" height="42" rx="6"></rect>
                  <text x="66" y="28" fill="#e8a59f" stroke="none" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="18" letter-spacing="4">REFUSED</text>
                  <path d="M-6 21 H138" stroke="var(--on-forest)" stroke-width="3"></path>
                </g>
                <path d="M212 110 C 240 110 250 92 268 92" stroke="var(--signal)" stroke-width="2.5" stroke-dasharray="5 6"></path>
                <path d="M262 84 L272 92 L262 100" stroke="var(--signal)" stroke-width="2.5"></path>
                <g transform="translate(296 104) rotate(10)" stroke="var(--signal)">
                  <circle r="62" stroke-width="4"></circle><circle r="52" stroke-width="1.5"></circle>
                  <g fill="var(--signal)" stroke="none" text-anchor="middle">
                    <text y="-18" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="3">REAPPLY</text>
                    <text y="8" font-family="Sora, sans-serif" font-size="16" font-weight="600">APPROVED</text>
                    <text y="28" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="3">2026</text>
                  </g>
                </g>
              </svg>
            </div>
            <span style="display: flex; gap: 8px; align-items: center; font-weight: 600; margin-top: auto">Start a refusal review <Icon name="arrow" size={22} class="go" stroke="var(--signal)" strokeWidth={2} /></span>
          </div>
          <div style="padding: 20px 20px 20px 0; display: flex">
            <Photo src={consultation} alt="Consultant reviewing documents with clients" style="flex: 1; min-height: 220px" />
          </div>
        </WaLink>
      </div>

    </div>
  </section>


  <!-- HOW IT WORKS -->
  <section id="how" class="sec" style="background: var(--surface-sunken)">
    <div class="art" aria-hidden="true">
      <svg style="position: absolute; right: -60px; top: 36px; transform: rotate(-6deg)" width="760" height="300" viewBox="0 0 760 300" fill="none" stroke="var(--signal)" stroke-width="3">
        <path d="M20 20 H520 a18 18 0 0 0 36 0 H740 V280 H556 a18 18 0 0 0 -36 0 H20 Z"></path>
        <path d="M538 52 V250" stroke-dasharray="6 8"></path>
        <g stroke-width="5"><path d="M590 70 V230"></path><path d="M604 70 V230" stroke-width="2"></path><path d="M614 70 V230"></path><path d="M630 70 V230" stroke-width="2"></path><path d="M640 70 V230" stroke-width="8"></path><path d="M658 70 V230" stroke-width="2"></path><path d="M668 70 V230"></path><path d="M684 70 V230" stroke-width="8"></path><path d="M700 70 V230" stroke-width="2"></path></g>
        <text x="56" y="110" fill="var(--signal)" stroke="none" font-family="Sora, sans-serif" font-size="64" font-weight="600">ABV → LHR</text>
        <text x="58" y="160" fill="var(--signal)" stroke="none" font-family="IBM Plex Mono, monospace" font-size="20" letter-spacing="4">GATE 04 · SEAT 12A · BOARDING</text>
        <text x="58" y="240" fill="var(--signal)" stroke="none" font-family="IBM Plex Mono, monospace" font-size="20" letter-spacing="4">PASSENGER · YOU</text>
      </svg>
    </div>
    <div class="wrap" data-steps-root style="display: flex; flex-direction: column; gap: 48px">
      <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start; max-width: 720px">
        <h2 class="h1">Five steps. You always know which one you're on.</h2>
        <p class="lead">Every client gets a reference number and a written update at each step.</p>
      </div>
      <div class="g-steps" role="tablist" aria-label="Application steps" data-steps style="position: relative">
        <div aria-hidden="true" class="hide-sm" style="position: absolute; left: 40px; right: 40px; top: 40px; height: 2px; background: var(--line)"></div>
        {STEPS.map((s, i) => (
          <button type="button" class="step" role="tab" id={`step-tab-${i}`} aria-controls={`step-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-key={String(i)}>
            <span class="dot">{i + 1}</span>
            <span class="h3" style="font-size: 18px; line-height: 26px; color: var(--ink)">{s.title}</span>
          </button>
        ))}
      </div>
      {STEPS.map((s, i) => (
        <div class="card" role="tabpanel" id={`step-panel-${i}`} aria-labelledby={`step-tab-${i}`} data-step-panel data-key={String(i)} hidden={i !== 0} style="padding: 32px">
          <div class="g-detail">
            <div style="display: flex; flex-direction: column; gap: 12px">
              <span class="meta" style="color: var(--forest)">STEP {i + 1} OF 5 · {s.code}</span>
              <h3 class="h1" style="font-size: 28px; line-height: 36px">{s.title}</h3>
              <p class="muted" style="margin: 0; max-width: 60ch">{s.body}</p>
            </div>
            <div style="display: flex; flex-direction: column; gap: 16px; padding: 24px; background: var(--forest-tint); border-radius: 8px">
              <span style="font-weight: 600; font-size: 14px; line-height: 20px; color: var(--forest); display: flex; align-items: center; gap: 8px"><Icon name="fileCheck" size={18} /> What to bring</span>
              <p style="margin: 0; font-size: 15px; line-height: 24px">{s.bring}</p>
              <span class="meta" style="color: var(--ink-subtle)">USUAL DURATION · {s.duration.toUpperCase()}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
