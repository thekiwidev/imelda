    <div class="art" aria-hidden="true">
      <svg style="position: absolute; left: -40px; top: 0" width="100%" height="100%" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" fill="#0f3d1f">
        <g>
          {[80, 120, 160].map((y) => [80, 120, 160, 200, 240].map((x) => <circle cx={x} cy={y} r="3"></circle>))}
        </g>
