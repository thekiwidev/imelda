---
// Photo slot from the design. Until a real, consenting photo exists it renders the design's hatched
// placeholder; the brief is drawn from a data attribute via CSS so it is not indexed as page text.
// To use a real photo, put it in src/assets and pass it as `src` with a descriptive `alt`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  alt: string;
  brief?: string;
  src?: ImageMetadata;
  icon?: 'photo' | 'video' | 'none';
  class?: string;
  style?: string;
  /** Above-the-fold hero images: load immediately for a faster Largest Contentful Paint. */
  eager?: boolean;
}
const { alt, brief, src, icon = 'photo', class: className, style, eager = false } = Astro.props;
const widths = src ? [480, 800, 1200].filter((w) => w <= src.width).concat(src.width < 1200 ? [src.width] : []) : [];
---

{src ? (
  <Image
    src={src}
    alt={alt}
    class:list={['ph-img', className]}
    style={style}
    widths={widths}
    sizes="(max-width: 900px) 100vw, 50vw"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
) : (
  <div class:list={['ph', className]} role="img" aria-label={alt} style={style}>
    {icon !== 'none' && (
      <span class="ph-label" aria-hidden="true">
        {icon === 'video' ? (
          <span style="width: 56px; height: 56px; border-radius: 999px; background: var(--forest); display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="var(--signal)"><path d="M7 4v16l13-8z" /></svg></span>
        ) : (
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>
        )}
        {brief && <span class="ph-tag" data-brief={brief}></span>}
      </span>
    )}
  </div>
)}
