---
import Icon from './Icon.astro';
import WaLink from './WaLink.astro';
import { site, callLink } from '../data/site';

interface Props { message?: string }
const { message = 'Hello Imelda Yayala, I need help with my application form.' } = Astro.props;
---

<section id="contact" style="background: var(--brass-tint); border-top: 1px solid rgba(138,97,24,.25); padding: 72px 0">
  <div class="wrap" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 720px">
    <span class="overline" style="color: var(--brass-ink)">Need help with the form?</span>
    <h2 class="h1">A consultant will walk you through it.</h2>
    <p class="muted" style="margin: 0">Message us on WhatsApp or call, and we'll answer any question before you submit.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 8px">
      <WaLink class="btn btn-primary" message={message}><Icon name="whatsapp" size={18} /> Message us on WhatsApp</WaLink>
      <a class="btn btn-secondary" href={callLink()}><Icon name="phone" size={18} /> Call {site.phone}</a>
    </div>
  </div>
</section>
