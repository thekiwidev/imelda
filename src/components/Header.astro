---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import WaLink from './WaLink.astro';
import { nav } from '../data/site';

interface Props { faqHref?: string }
const { faqHref = '#faq' } = Astro.props;
const path = Astro.url.pathname;
const links = [...nav, { label: 'FAQ', href: faqHref }];
---

<header style="position: sticky; top: 0; z-index: 30; background: var(--surface); border-bottom: 1px solid var(--line)">
  <div class="wrap" style="height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 24px">
    <a href="/" style="display: flex; align-items: center; text-decoration: none"><Logo eager height={44} /></a>
    <nav class="nav-links" aria-label="Main" style="display: flex; align-items: center; gap: 24px">
      {links.map((item) => (
        <a class="navlink" href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div style="display: flex; align-items: center; gap: 8px">
      <WaLink class="btn btn-primary btn-sm"><span>Book<span class="hide-sm"> a consultation</span></span> <Icon name="arrow" size={18} stroke="var(--signal)" strokeWidth={2} class="arr" /></WaLink>
      <details class="menu">
        <summary class="iconbtn" aria-label="Menu"><span class="menu-bars" aria-hidden="true"></span></summary>
        <nav aria-label="Mobile" class="menu-panel">
          {links.map((item) => (
            <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
          ))}
          <WaLink class="btn btn-accent"><Icon name="whatsapp" size={20} /> Book a consultation</WaLink>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('details.menu');
  const close = () => { if (menu) menu.open = false; };
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.menu-panel a')) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  window.matchMedia('(min-width: 901px)').addEventListener('change', close);
</script>
