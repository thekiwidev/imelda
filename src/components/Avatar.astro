---
interface Props { initials: string; size?: number; tone?: 'lime' | 'forest' }
const { initials, size = 48, tone = 'forest' } = Astro.props;
const colors = tone === 'lime'
  ? 'background: var(--surface); color: var(--forest); border: 1px solid var(--lime-line)'
  : 'background: var(--forest-tint); color: var(--forest); border: 1px solid rgba(15,61,31,.2)';
---

<span aria-hidden="true" style={`width: ${size}px; height: ${size}px; border-radius: 999px; flex: none; display: flex; align-items: center; justify-content: center; font-family: var(--f-display); font-weight: 600; font-size: ${Math.round(size * 0.34)}px; ${colors}`}>{initials}</span>
